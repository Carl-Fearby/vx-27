{
  "name": "game-engine2-fps",
  "private": true,
  "version": "0.1.60",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:http": "node scripts/dev.mjs --http",
    "dev:reset": "node scripts/dev.mjs --reset",
    "dev:turbo": "node scripts/dev.mjs --turbo",
    "dev:webpack": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "clean": "node scripts/clean-next.mjs",
    "wasm:build": "npm run wasm:build:hack && npm run wasm:build:game",
    "wasm:build:hack": "wasm-pack build rust/hack_core --target web --out-dir pkg",
    "wasm:build:game": "wasm-pack build rust/game_core --target web --out-dir pkg",
    "wasm:test": "cargo test --manifest-path rust/hack_core/Cargo.toml && cargo test --manifest-path rust/game_core/Cargo.toml",
    "wasm:watch:hack": "cargo watch -w rust/hack_core/src -s \"wasm-pack build rust/hack_core --target web --out-dir pkg\"",
    "wasm:watch:game": "cargo watch -w rust/game_core/src -s \"wasm-pack build rust/game_core --target web --out-dir pkg\"",
    "prebuild": "node scripts/clean-next.mjs && node scripts/generate-version-history.mjs",
    "version:history": "node scripts/generate-version-history.mjs",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs --patch",
    "release:minor": "node scripts/release.mjs --minor",
    "release:major": "node scripts/release.mjs --major",
    "release:sync-commit": "node scripts/release.mjs --sync-commit",
    "textures:oil-barrel": "node scripts/optimize-oil-barrel-textures.mjs all",
    "textures:game": "node scripts/optimize-game-textures.mjs all",
    "textures:vx27-container": "node scripts/optimize-vx27-container-textures.mjs --prune-png --prune-unused",
    "textures:control-panel-screen-c": "node scripts/optimize-control-panel-screen-c.mjs",
    "textures:control-panel-shelf-d": "node scripts/optimize-control-panel-shelf-d.mjs",
    "textures:control-panel-body": "node scripts/optimize-control-panel-body.mjs",
    "textures:control-panel-hull": "node scripts/optimize-control-panel-hull.mjs",
    "textures:sky": "node scripts/optimize-sky-dome.mjs",
    "textures:ui": "node scripts/optimize-ui-images.mjs",
    "pile:barrels": "node scripts/generate-oil-barrel-pile.mjs --write",
    "pile:barrels:dry": "node scripts/generate-oil-barrel-pile.mjs",
    "pile:barrels:check": "node scripts/oil-barrel-pile-probe.mjs",
    "deploy:fasthosts": "node scripts/deploy-fasthosts.mjs",
    "deploy:fasthosts:build": "node scripts/deploy-fasthosts.mjs --build-only",
    "deploy:fasthosts:probe": "node scripts/deploy-fasthosts.mjs --probe"
  },
  "devDependencies": {
    "basic-ftp": "^5.3.1",
    "playwright": "^1.60.0"
  },
  "dependencies": {
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.184.0"
  }
}
