{
  "name": "game-engine2-fps",
  "private": true,
  "version": "0.1.5",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:http": "node scripts/dev.mjs --http",
    "dev:reset": "node scripts/dev.mjs --reset",
    "dev:webpack": "node scripts/dev.mjs --webpack",
    "build": "next build",
    "start": "next start",
    "clean": "node scripts/clean-next.mjs",
    "prebuild": "node scripts/clean-next.mjs && node scripts/generate-version-history.mjs",
    "version:history": "node scripts/generate-version-history.mjs",
    "textures:oil-barrel": "node scripts/optimize-oil-barrel-textures.mjs all",
    "textures:game": "node scripts/optimize-game-textures.mjs all",
    "textures:vx27-container": "node scripts/optimize-vx27-container-textures.mjs --prune-png --prune-unused",
    "textures:sky": "node scripts/optimize-sky-dome.mjs",
    "textures:ui": "node scripts/optimize-ui-images.mjs",
    "pile:barrels": "node scripts/generate-oil-barrel-pile.mjs --write",
    "pile:barrels:dry": "node scripts/generate-oil-barrel-pile.mjs",
    "pile:barrels:check": "node scripts/oil-barrel-pile-probe.mjs",
    "deploy:fasthosts": "node scripts/deploy-fasthosts.mjs",
    "deploy:fasthosts:build": "node scripts/deploy-fasthosts.mjs --build-only",
    "deploy:fasthosts:probe": "node scripts/deploy-fasthosts.mjs --probe"
  },
  "devDependencies": {
    "basic-ftp": "^5.3.1"
  },
  "dependencies": {
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0"
  }
}
