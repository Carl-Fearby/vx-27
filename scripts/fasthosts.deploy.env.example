# Copy to scripts/fasthosts.deploy.env (gitignored — never commit credentials).
#   cp scripts/fasthosts.deploy.env.example scripts/fasthosts.deploy.env
# Put the real password only in scripts/fasthosts.deploy.env or FASTHOSTS_FTP_PASSWORD in the shell.
FASTHOSTS_FTP_HOST=ftp.fasthosts.co.uk
FASTHOSTS_FTP_USER=your-ftp-username
FASTHOSTS_FTP_PASSWORD=
# Leave as "." if FTP login already opens /htdocs (typical Fasthosts).
# Use HTDOCS only when login lands at account root next to LOGFILES.
FASTHOSTS_FTP_REMOTE_DIR=.

# WASM MIME (application/wasm):
# Root public/.htaccess is deployed with the site; deploy-fasthosts.mjs also writes
# _next/static/media/.htaccess beside the hashed *.wasm bundles after each build.
